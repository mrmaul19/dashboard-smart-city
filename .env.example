# Copy to `.env.local` and fill in. `.env*` is git-ignored.

# OpenAQ v3 air-quality API key — required for the air-quality panels.
# Free registration: https://explore.openaq.org/register
#
# Server-side only: it is read exclusively inside `src/app/api/air-quality/`
# and must never be given a NEXT_PUBLIC_ prefix, which would ship it to the
# browser. Limits are 60 requests/minute and 2,000/hour per key, and OpenAQ's
# docs warn that repeated overuse can lead to a ban.
OPENAQ_API_KEY=

# Optional: override the default Overpass instance used by the snapshot
# generator (scripts/fetch-city-data.ts). Mirrors are tried in order.
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
